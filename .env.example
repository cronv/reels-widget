# Сервер
PORT=4000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:4000
OUTPUT_DIR=.output
LOG_REQUESTS=false

# Кто может встраивать виджет и обращаться к API.
# Пусто = любой домен. Заполните перед продом.
ALLOWED_ORIGINS=

# Какие домены можно разбирать через /api/extract/url.
# Пусто = любой. Заполните перед продом, иначе это открытый загрузчик страниц.
SCRAPE_ALLOWED_HOSTS=

# Собственные домены, для которых проверка robots.txt пропускается.
# Это не выключатель проверки: для всех остальных доменов она работает.
# Вносите только то, чем владеете.
# SCRAPE_TRUSTED_HOSTS=alphasuper-baza.ru
SCRAPE_TRUSTED_HOSTS=
SCRAPE_RESPECT_ROBOTS=true

# Разрешить разбор localhost и внутренних адресов.
# Только для локальной отладки — в проде это открытый SSRF.
SCRAPE_ALLOW_PRIVATE=false
SCRAPE_TIMEOUT_MS=15000

# Рендер
RENDER_CONCURRENCY=2
RENDER_CRF=20
RENDER_TIMEOUT_MS=240000
RENDER_KEEP_FILES=200
# CHROMIUM_PATH=/usr/bin/chromium
# FFMPEG_PATH=ffmpeg

# Фиды
FEED_MAX_BYTES=26214400
FEED_MAX_OFFERS=500

{
  "name": "reels-widget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Виджет: карточка ЖК/лота из фида, ссылки или формы → вертикальные рилсы 10 и 15 секунд",
  "workspaces": [
    "packages/core",
    "packages/server"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/server",
    "dev": "npm run build && node --watch packages/server/dist/index.js",
    "start": "node packages/server/dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -b --force packages/core packages/server",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "parse": "node scripts/parse.mjs",
    "bundle": "node scripts/bundle.mjs",
    "docker:build": "docker compose -f deploy/docker-compose.yml build",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d",
    "docker:smoke": "docker compose -f deploy/docker-compose.yml run --rm --no-deps reels npm run smoke",
    "verify": "node scripts/verify-env.mjs",
    "sparse": "node scripts/sparse-check.mjs",
    "download-check": "node scripts/download-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}

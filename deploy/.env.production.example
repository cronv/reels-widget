# ── доступ: заполнить обязательно ───────────────────────────────────────
# Сервис виден снаружи, а рендер занимает ядро на минуту. Без пароля его
# API открыт всем желающим, поэтому в продакшене сервер без него не
# стартует.
#
# Пароль — один на всех менеджеров, его вводят в виджете один раз.
ACCESS_PASSWORD=

# Секрет для подписи сессий. Любая длинная случайная строка, минимум
# 16 символов: openssl rand -base64 32
# Если не задать, сессии будут сбрасываться при каждом перезапуске.
AUTH_SECRET=

# Сколько держится вход, часов.
SESSION_TTL_HOURS=12

# Лимиты на одного клиента. Рендер дорогой, поэтому его потолок ниже.
LIMIT_RENDER_PER_HOUR=30
LIMIT_EXTRACT_PER_HOUR=120
LIMIT_LOGIN_PER_15MIN=10

# Доверять X-Forwarded-For при определении адреса клиента.
# true — когда перед сервисом стоит свой nginx (обычный случай).
# Если сервис смотрит в интернет напрямую, поставьте false:
# иначе заголовок подделают и обойдут лимиты.
TRUST_PROXY=true

# ── адреса: заполнить обязательно ───────────────────────────────────────
# Адрес, по которому сервис виден снаружи. Попадает в ссылки на готовые
# файлы, поэтому должен быть именно внешним и по https.
PUBLIC_URL=https://reels.example.ru

# Домены, которым разрешено встраивать виджет и обращаться к API.
# Домен самого сервиса вписывать не нужно — он разрешён всегда.
ALLOWED_ORIGINS=https://example.ru

# Какие домены можно разбирать по ссылке. Без этого списка эндпоинт
# превращается в анонимный загрузчик произвольных страниц.
SCRAPE_ALLOWED_HOSTS=example.ru

# Свои домены, на которых robots.txt закрывает сайт целиком.
# Это список собственных сайтов, а не отключение проверки.
SCRAPE_TRUSTED_HOSTS=

# ── сервер ──────────────────────────────────────────────────────────────
# В Docker значения HOST, PORT, OUTPUT_DIR и CHROMIUM_PATH задаёт
# docker-compose.yml и перекрывает этот файл — здесь они только для
# установки без контейнера.
PORT=4000
HOST=127.0.0.1
OUTPUT_DIR=/opt/reels-widget/.output
LOG_REQUESTS=false

# ── рендер ──────────────────────────────────────────────────────────────
# Процессов Chromium получается CONCURRENCY × WORKERS, каждый ~400 МБ.
#
# Один ролик за раз, кадры к нему снимают два процесса: на двух ядрах
# это вдвое быстрее, чем один процесс, а два ролика сразу всё равно
# делили бы те же ядра и каждый ждал бы дольше.
RENDER_CONCURRENCY=1
RENDER_WORKERS=2
RENDER_CRF=20
RENDER_TIMEOUT_MS=240000
RENDER_KEEP_FILES=200

# ── разбор страниц ──────────────────────────────────────────────────────
SCRAPE_RESPECT_ROBOTS=true
SCRAPE_TIMEOUT_MS=15000
# Только для локальной отладки. В проде оставить false.
SCRAPE_ALLOW_PRIVATE=false

FEED_MAX_BYTES=26214400
FEED_MAX_OFFERS=500
